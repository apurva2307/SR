# Postgres
DATABASE_URL=postgres://sr:sr@localhost:5432/service_records

# Where the service record PDFs live. Comma-separated. Mount these READ-ONLY.
SR_SOURCE_ROOTS=/srv/service-records

# Grant policy (§15). Enforced in the database too — these are the UI defaults.
GRANT_DEFAULT_DAYS=15
GRANT_MAX_DAYS=180

# PPO validation (§8)
PPO_STANDARD_LENGTH=12
PPO_MIN_LENGTH=6
PPO_MAX_LENGTH=14

# Watermark font. Alpine: apk add font-dejavu
WATERMARK_FONT=/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf

# Development only. In production TLS terminates in front and this must be true.
COOKIE_SECURE=false

# Backups (README, Backups). The age PUBLIC key; the private key stays offline.
BACKUP_AGE_RECIPIENT=age1...
# BACKUP_HOUR=2
# BACKUP_TZ=Asia/Kolkata
