{
  "name": "sevalekh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "node --experimental-strip-types db/migrate.ts",
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "test:unit": "node --experimental-strip-types --test test/parseFilename.test.ts test/normalize.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "bootstrap:admin": "node --experimental-strip-types scripts/bootstrap-admin.ts",
    "ingest": "node --experimental-strip-types scripts/ingest.ts",
    "reparse-names": "node --experimental-strip-types scripts/reparse-names.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.1",
    "mupdf": "^1.0.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource/hind": "^5.2.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
